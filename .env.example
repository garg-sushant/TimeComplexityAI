# Gemini API Configuration
# Option 1: Single API Key
VITE_GEMINI_API_KEY="AIzaSy..."

# Option 2: Multiple API Keys (Rotation Pool)
# Use a comma-separated list of keys. The system will automatically rotate 
# and handle rate-limits/exhaustion for each key.
VITE_GEMINI_API_KEYS="KEY1,KEY2,KEY3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

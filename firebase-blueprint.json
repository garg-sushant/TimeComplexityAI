{
  "entities": {
    "Analysis": {
      "title": "Analysis",
      "description": "A code complexity analysis result.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "The code that was analyzed."
        },
        "complexity": {
          "type": "string",
          "description": "The Big O time complexity (e.g., O(N^2))."
        },
        "complexityClass": {
          "type": "string",
          "description": "The general complexity class (e.g., O(1), O(N))."
        },
        "spaceComplexity": {
          "type": "string",
          "description": "The Big O space complexity (e.g., O(1))."
        },
        "explanationPoints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "A structured list of points explaining the complexity."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the analysis was performed."
        }
      },
      "required": ["code", "complexity", "complexityClass", "spaceComplexity", "explanationPoints", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "photoURL": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profiles."
    },
    "users/{userId}/analyses/{analysisId}": {
      "schema": {
        "$ref": "#/entities/Analysis"
      },
      "description": "Analyses performed by the user."
    }
  }
}
